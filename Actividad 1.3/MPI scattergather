using namespace std;

class RegistroLog {
private:
    ofstream archivo;
public:
    RegistroLog(const string& nombreArchivo) {
        archivo.open(nombreArchivo);
    }
    ~RegistroLog() {
        if (archivo.is_open()) archivo.close();
    }
    void escribir(const string& mensaje) {
        cout << mensaje << endl;
        if (archivo.is_open()) {
            archivo << mensaje << endl;
            archivo.flush();
        }
    }
};

class OperacionesArreglos {
public:

    static void crearArregloMPI(long long*& A, long long*& B, long long*& C, long long tamanoLocal) {
        A = new long long[tamanoLocal];
        B = new long long[tamanoLocal];
        C = new long long[tamanoLocal];
    }

      static void llenarSecuencial(long long* A, long long* B, long long cantidad, long long inicioGlobal,
                                   int rank, const string& equipo, bool detallado, RegistroLog& log) {
        #pragma omp parallel
        {
            int idHilo = omp_get_thread_num();
            #pragma omp for schedule(static)
            for (long long i = 0; i < cantidad; i++) {
                long long posGlobal = inicioGlobal + i;
                A[i] = posGlobal;
                B[i] = posGlobal + 1;

                if (detallado) {
                    ostringstream msg;
                    msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                        << "][Hilo OpenMP: " << idHilo << "][Posicion: " << posGlobal
                        << "][Operacion: Llenado secuencial][Valor A: " << A[i] << "][Valor B: " << B[i] << "]";
                    #pragma omp critical(logCreacion)
                    { log.escribir(msg.str()); }
                }
            }
        }
    }

    static void llenarAleatorio(long long* A, long long* B, long long cantidad, long long inicioGlobal,
                                  int rank, const string& equipo, bool detallado, RegistroLog& log) {
        #pragma omp parallel
        {
            int idHilo = omp_get_thread_num();
            thread_local mt19937 generador((unsigned int)time(NULL) + rank * 104729u + idHilo * 7919u);
            uniform_int_distribution<long long> distribucion(1, 1000000);

            #pragma omp for schedule(static)
            for (long long i = 0; i < cantidad; i++) {
                A[i] = distribucion(generador);
                B[i] = distribucion(generador);

                if (detallado) {
                    ostringstream msg;
                    msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                        << "][Hilo OpenMP: " << idHilo << "][Posicion: " << (inicioGlobal + i)
                        << "][Operacion: Llenado aleatorio][Valor A: " << A[i] << "][Valor B: " << B[i] << "]";
                    #pragma omp critical(logCreacion)
                    { log.escribir(msg.str()); }
                }
            }
        }
    }

    static void sumarSeccion(long long* A, long long* B, long long* C, long long cantidad, long long inicioGlobal,
                               int rank, const string& equipo, bool detallado, RegistroLog& log) {
        #pragma omp parallel for
        for (long long i = 0; i < cantidad; i++) {
            C[i] = A[i] + B[i];
            if (detallado) {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                    << "][Hilo OpenMP: " << omp_get_thread_num() << "][Posicion: " << (inicioGlobal + i)
                    << "][Operacion: Suma][Valor: " << C[i] << "]";
                #pragma omp critical(logOperacion)
                { log.escribir(msg.str()); }
            }
        }
    }

    static void restarSeccion(long long* A, long long* B, long long* C, long long cantidad, long long inicioGlobal,
                                int rank, const string& equipo, bool detallado, RegistroLog& log) {
        #pragma omp parallel for
        for (long long i = 0; i < cantidad; i++) {
            C[i] = A[i] - B[i];
            if (detallado) {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                    << "][Hilo OpenMP: " << omp_get_thread_num() << "][Posicion: " << (inicioGlobal + i)
                    << "][Operacion: Resta][Valor: " << C[i] << "]";
                #pragma omp critical(logOperacion)
                { log.escribir(msg.str()); }
            }
        }
    }

    static void multiplicarSeccion(long long* A, long long* B, long long* C, long long cantidad, long long inicioGlobal,
                                     int rank, const string& equipo, bool detallado, RegistroLog& log) {
        #pragma omp parallel for
        for (long long i = 0; i < cantidad; i++) {
            C[i] = A[i] * B[i];
            if (detallado) {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                    << "][Hilo OpenMP: " << omp_get_thread_num() << "][Posicion: " << (inicioGlobal + i)
                    << "][Operacion: Multiplicacion][Valor: " << C[i] << "]";
                #pragma omp critical(logOperacion)
                { log.escribir(msg.str()); }
            }
        }
    }

    static void cuadradoSeccion(long long* A, long long* C, long long cantidad, long long inicioGlobal,
                                  int rank, const string& equipo, bool detallado, RegistroLog& log) {
        #pragma omp parallel for
        for (long long i = 0; i < cantidad; i++) {
            C[i] = A[i] * A[i];
            if (detallado) {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                    << "][Hilo OpenMP: " << omp_get_thread_num() << "][Posicion: " << (inicioGlobal + i)
                    << "][Operacion: Cuadrado][Valor: " << C[i] << "]";
                #pragma omp critical(logOperacion)
                { log.escribir(msg.str()); }
            }
        }
    }

    static long long sumatoriaLocalOpenMP(long long* A, long long cantidad, long long inicioGlobal,
                                            int rank, const string& equipo, bool detallado, RegistroLog& log) {
        long long suma_local = 0;
        #pragma omp parallel for reduction(+:suma_local)
        for (long long i = 0; i < cantidad; i++) {
            suma_local += A[i];
            if (detallado) {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                    << "][Hilo OpenMP: " << omp_get_thread_num() << "][Posicion: " << (inicioGlobal + i)
                    << "][Operacion: Sumatoria Local][Valor: " << A[i] << "]";
                #pragma omp critical(logReduccion)
                { log.escribir(msg.str()); }
            }
        }
        return suma_local;
    }

    static long long maximoLocalOpenMP(long long* A, long long cantidad, long long inicioGlobal,
                                         int rank, const string& equipo, bool detallado, RegistroLog& log) {
        long long max_local = A[0];
        #pragma omp parallel for reduction(max:max_local)
        for (long long i = 0; i < cantidad; i++) {
            if (A[i] > max_local) max_local = A[i];
            if (detallado) {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                    << "][Hilo OpenMP: " << omp_get_thread_num() << "][Posicion: " << (inicioGlobal + i)
                    << "][Operacion: Maximo Local][Valor: " << A[i] << "]";
                #pragma omp critical(logReduccion)
                { log.escribir(msg.str()); }
            }
        }
        return max_local;
    }

    static long long minimoLocalOpenMP(long long* A, long long cantidad, long long inicioGlobal,
                                         int rank, const string& equipo, bool detallado, RegistroLog& log) {
        long long min_local = A[0];
        #pragma omp parallel for reduction(min:min_local)
        for (long long i = 0; i < cantidad; i++) {
            if (A[i] < min_local) min_local = A[i];
            if (detallado) {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank
                    << "][Hilo OpenMP: " << omp_get_thread_num() << "][Posicion: " << (inicioGlobal + i)
                    << "][Operacion: Minimo Local][Valor: " << A[i] << "]";
                #pragma omp critical(logReduccion)
                { log.escribir(msg.str()); }
            }
        }
        return min_local;
    }
};

void distribuirScatter(long long* completo, long long* local, long long tamanoLocal) {
    MPI_Scatter(completo, tamanoLocal, MPI_LONG_LONG, local, tamanoLocal, MPI_LONG_LONG, 0, MPI_COMM_WORLD);
}

void recolectarGather(long long* completo, long long* local, long long tamanoLocal) {
    MPI_Gather(local, tamanoLocal, MPI_LONG_LONG, completo, tamanoLocal, MPI_LONG_LONG, 0, MPI_COMM_WORLD);
}

long long combinarSumaGather(long long parcialLocal, int rank, int numProcesos) {
    long long* parciales = nullptr;
    if (rank == 0) parciales = new long long[numProcesos];
    MPI_Gather(&parcialLocal, 1, MPI_LONG_LONG, parciales, 1, MPI_LONG_LONG, 0, MPI_COMM_WORLD);

    long long total = 0;
    if (rank == 0) {
        for (int i = 0; i < numProcesos; i++) total += parciales[i];
        delete[] parciales;
    }
    return total;
}

long long combinarMaximoGather(long long parcialLocal, int rank, int numProcesos) {
    long long* parciales = nullptr;
    if (rank == 0) parciales = new long long[numProcesos];
    MPI_Gather(&parcialLocal, 1, MPI_LONG_LONG, parciales, 1, MPI_LONG_LONG, 0, MPI_COMM_WORLD);

    long long maxGlobal = parcialLocal;
    if (rank == 0) {
        maxGlobal = parciales[0];
        for (int i = 1; i < numProcesos; i++) if (parciales[i] > maxGlobal) maxGlobal = parciales[i];
        delete[] parciales;
    }
    return maxGlobal;
}

long long combinarMinimoGather(long long parcialLocal, int rank, int numProcesos) {
    long long* parciales = nullptr;
    if (rank == 0) parciales = new long long[numProcesos];
    MPI_Gather(&parcialLocal, 1, MPI_LONG_LONG, parciales, 1, MPI_LONG_LONG, 0, MPI_COMM_WORLD);

    long long minGlobal = parcialLocal;
    if (rank == 0) {
        minGlobal = parciales[0];
        for (int i = 1; i < numProcesos; i++) if (parciales[i] < minGlobal) minGlobal = parciales[i];
        delete[] parciales;
    }
    return minGlobal;
}

const long long LIMITE_IMPRESION = 200;

void imprimirArreglo(const string& nombre, long long* arr, long long n, RegistroLog& log) {
    ostringstream msg;
    msg << nombre << ": [ ";
    for (long long i = 0; i < n; i++) msg << arr[i] << " ";
    msg << "]";
    log.escribir(msg.str());
}

int main(int argc, char** argv) {
    MPI_Init(&argc, &argv);

    int rank, numProcesos;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &numProcesos);

    char nombreEquipoBuf[MPI_MAX_PROCESSOR_NAME];
    int longitudNombre;
    MPI_Get_processor_name(nombreEquipoBuf, &longitudNombre);
    string equipo(nombreEquipoBuf);

    ostringstream nombreLog;
    nombreLog << "log_equipo_" << equipo << "_nodo_" << rank << ".txt";
    RegistroLog log(nombreLog.str());

    {
        ostringstream msg;
        msg << "Avila Martinez Marco | Larios Hernandez Carlos Alberto | Macias Renteria Dante Yael | Salcedo Ramos Luis Gael";
        if (rank == 0) log.escribir(msg.str());
    }
    if (rank == 0) {
        ostringstream msg;
        msg << "=== VERSION Scatter/Gather === Procesos MPI: " << numProcesos << " (1 maestro + " << (numProcesos - 1) << " trabajadores)";
        log.escribir(msg.str());
    }

    long long tamano = 0, tamanoLocal = 0, inicioLocal = 0;
    long long* A = nullptr, * B = nullptr, * C = nullptr;
    long long* Alocal = nullptr, * Blocal = nullptr, * Clocal = nullptr;
    bool detallado = true;

    int opcion = -1;

    do {
        if (rank == 0) {
            cout << "\n===== MENU REDUCE EN MPI + OPENMP (Scatter/Gather) =====\n";
            cout << "1. Crear arreglos\n";
            cout << "2. Sumar arreglos\n";
            cout << "3. Restar arreglos\n";
            cout << "4. Multiplicar arreglos\n";
            cout << "5. Cuadrado del arreglo A\n";
            cout << "6. Llenar secuencial\n";
            cout << "7. Llenar aleatorio\n";
            cout << "8. Sumatoria\n";
            cout << "9. Promedio\n";
            cout << "10. Maximo\n";
            cout << "11. Minimo\n";
            cout << "12. Salir\n";
            cout << "Seleccione una opcion: ";
            cin >> opcion;
        }
        MPI_Bcast(&opcion, 1, MPI_INT, 0, MPI_COMM_WORLD);

        if (opcion == 1) {
            if (rank == 0) {
                cout << "Ingrese el tamano TOTAL del arreglo (multiplo de " << numProcesos << "): ";
                cin >> tamano;
            }
            MPI_Bcast(&tamano, 1, MPI_LONG_LONG, 0, MPI_COMM_WORLD);

            if (tamano <= 0 || tamano % numProcesos != 0) {
                if (rank == 0) cout << "Tamano invalido: debe ser multiplo exacto de " << numProcesos << ".\n";
                continue;
            }

            char detalladoChar = 'S';
            if (rank == 0) {
                cout << "Mostrar/registrar mensajes detallados por elemento? (S/N): ";
                cin >> detalladoChar;
            }
            MPI_Bcast(&detalladoChar, 1, MPI_CHAR, 0, MPI_COMM_WORLD);
            detallado = (detalladoChar == 'S' || detalladoChar == 's');

            delete[] A; delete[] B; delete[] C; A = B = C = nullptr;
            delete[] Alocal; delete[] Blocal; delete[] Clocal;

            tamanoLocal = tamano / numProcesos;
            inicioLocal = (long long)rank * tamanoLocal;
            OperacionesArreglos::crearArregloMPI(Alocal, Blocal, Clocal, tamanoLocal);

            if (rank == 0) {
                A = new long long[tamano];
                B = new long long[tamano];
                C = new long long[tamano];
            }
            {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: " << rank << "] Arreglos locales creados ("
                    << tamanoLocal << " elementos). Use opcion 6 o 7 para llenarlos.";
                log.escribir(msg.str());
            }
        }
        else if (opcion == 6 || opcion == 7) {
            if (Alocal == nullptr) {
                if (rank == 0) cout << "Primero debe crear los arreglos (opcion 1).\n";
                continue;
            }
            if (opcion == 6) {
                OperacionesArreglos::llenarSecuencial(Alocal, Blocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
            } else {
                OperacionesArreglos::llenarAleatorio(Alocal, Blocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
            }
            MPI_Barrier(MPI_COMM_WORLD);
            if (rank == 0) {
                ostringstream msg;
                msg << "[Equipo: " << equipo << "][Proceso MPI: 0] Llenado completado en todos los nodos.";
                log.escribir(msg.str());
            }
        }
        else if (opcion >= 2 && opcion <= 5) {
            if (Alocal == nullptr) {
                if (rank == 0) cout << "Primero debe crear y llenar los arreglos (opciones 1 y 6/7).\n";
                continue;
            }

            MPI_Barrier(MPI_COMM_WORLD);
            double inicioTiempo = MPI_Wtime();

            string nombreOp;
            switch (opcion) {
                case 2: nombreOp = "SUMA";
                    OperacionesArreglos::sumarSeccion(Alocal, Blocal, Clocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
                    break;
                case 3: nombreOp = "RESTA";
                    OperacionesArreglos::restarSeccion(Alocal, Blocal, Clocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
                    break;
                case 4: nombreOp = "MULTIPLICACION";
                    OperacionesArreglos::multiplicarSeccion(Alocal, Blocal, Clocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
                    break;
                case 5: nombreOp = "CUADRADO";
                    OperacionesArreglos::cuadradoSeccion(Alocal, Clocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
                    break;
            }

            if (rank == 0 && C == nullptr) C = new long long[tamano];
            recolectarGather(C, Clocal, tamanoLocal);

            double finTiempo = MPI_Wtime();

            if (rank == 0) {
                ostringstream msg;
                msg << "--- Resultado: " << nombreOp << " (Scatter/Gather) ---";
                log.escribir(msg.str());
                if (tamano <= LIMITE_IMPRESION) imprimirArreglo("Arreglo C", C, tamano, log);
                ostringstream tiempoMsg;
                tiempoMsg << fixed << setprecision(6) << "Tiempo de ejecucion: " << (finTiempo - inicioTiempo) << " segundos";
                log.escribir(tiempoMsg.str());
            }
        }
        else if (opcion >= 8 && opcion <= 11) {
            if (Alocal == nullptr) {
                if (rank == 0) cout << "Primero debe crear y llenar los arreglos (opciones 1 y 6/7).\n";
                continue;
            }

            MPI_Barrier(MPI_COMM_WORLD);
            double inicioTiempo = MPI_Wtime();

            long long resultadoGlobal = 0;
            string nombreOp;

            if (opcion == 8 || opcion == 9) {
                nombreOp = (opcion == 8) ? "SUMATORIA" : "PROMEDIO";
                long long sumaLocal = OperacionesArreglos::sumatoriaLocalOpenMP(Alocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
                resultadoGlobal = combinarSumaGather(sumaLocal, rank, numProcesos);
            } else if (opcion == 10) {
                nombreOp = "MAXIMO";
                long long maxLocal = OperacionesArreglos::maximoLocalOpenMP(Alocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
                resultadoGlobal = combinarMaximoGather(maxLocal, rank, numProcesos);
            } else {
                nombreOp = "MINIMO";
                long long minLocal = OperacionesArreglos::minimoLocalOpenMP(Alocal, tamanoLocal, inicioLocal, rank, equipo, detallado, log);
                resultadoGlobal = combinarMinimoGather(minLocal, rank, numProcesos);
            }

            double finTiempo = MPI_Wtime();

            if (rank == 0) {
                ostringstream msg;
                msg << "--- Resultado: " << nombreOp << " (combinado via MPI_Gather + combinacion manual) ---";
                log.escribir(msg.str());
                if (opcion == 9) {
                    ostringstream prom;
                    prom << "Promedio global: " << (double)resultadoGlobal / (double)tamano;
                    log.escribir(prom.str());
                } else {
                    ostringstream val;
                    val << "Valor global: " << resultadoGlobal;
                    log.escribir(val.str());
                }
                ostringstream tiempoMsg;
                tiempoMsg << fixed << setprecision(6) << "Tiempo de ejecucion: " << (finTiempo - inicioTiempo) << " segundos";
                log.escribir(tiempoMsg.str());
            }
        }
        else if (opcion == 12) {
            if (rank == 0) cout << "Saliendo del programa...\n";
        }
        else {
            if (rank == 0) cout << "Opcion invalida.\n";
        }

    } while (opcion != 12);

    delete[] A; delete[] B; delete[] C;
    delete[] Alocal; delete[] Blocal; delete[] Clocal;

    MPI_Barrier(MPI_COMM_WORLD);
    if (rank == 0) {
        log.escribir("Avila Martinez Marco | Larios Hernandez Carlos Alberto | Macias Renteria Dante Yael | Salcedo Ramos Luis Gael");
    }

    MPI_Finalize();
    return 0;
}
